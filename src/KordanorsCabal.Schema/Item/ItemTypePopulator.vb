    Friend Sub PopulateLores(connection As SqliteConnection)
        PopulateLoreRecord(connection, LoreType1, "Genso Manifest Pg137", "My ears cannot stand the constant scratching at the door. The chamber is sealed with magics cast in the ancient days by the morntai keepers in service to Larak, but they are centuries gone. From generation to generation my kin have kept vigil, not to keep the captive within, but to keep those that seek his release without. There are fewer of us in each generation. I fear one day we shall be no more, and what then?")
        PopulateLoreRecord(connection, LoreType2, "Breviary of Dom Pg76", "Each night my brothers an I pray earnestly to the three Gods in Grot, but the howls from the other side of the sealed door weaken our knees. We are taught that the seal cannot be undone without the reuniting of the shards, and the art of shardmending has been lost to time, we are told. Some of us are not so sure.")
        PopulateLoreRecord(connection, LoreType3, "Londo's Canticle Pg32", "The first of the shards has been found and awakened. Within it are held the powers of vanishing and reappearing. We have entrusted it to a younger brother for safe keeping. I can only hope our faith in him is well placed. It has dangerous sorcery within it.")
        PopulateLoreRecord(connection, LoreType4, "Tome of Krass Pg8", "Praise be to Reylon, Shyrana, and Larak, for saving the very life of our glorious leader with the power of the healing shard. It is a critical time for us, and without the reinforcement that the gods are with us, our brotherhood would fall away from its mission.")
        PopulateLoreRecord(connection, LoreType5, "Haikus of Esdjee #15", "Keep him in prison/for the one seeking his death/shall overtake all")
        PopulateLoreRecord(connection, LoreType6, "Bartulicas' Plea", "An answer must be found to banish Kordanor forever back to Jhama where he belongs. All efforts towards this have been meaningless vanity. An answer must exist and must be found, already we can feel the overpowerer approaching. We must not fail.")
        PopulateLoreRecord(connection, LoreType7, "Z's Epistle", "I have arrived. Yer time is nearly up. I cannot enter yer realm for your many wards of protection, but I will find a way to send another to fetch what I need. -Z")
        PopulateLoreRecord(connection, LoreType8, "Cellarer's Ledger", "Bread, 40 loaves. Candles, 200. Lamp oil, none, as the Brothers say the dark is holy, and I say the dark is cheap. Salt fish, rotten again. The old man from the village left more bread at the gate and asked, as he always does, after the Master's health. He asks very often. He asks as a man asks after a roast he is waiting on. I did not like his smile and I have not eaten the bread.")
        PopulateLoreRecord(connection, LoreType9, "Hask's Complaint", "I did not take the vow to sit in the dark and listen to the Master weep. Seven years of it! The elders say he is safe in there from a hunter, and I say a man who is safe should be let out for a walk. I will open the door myself if the shardkeepers will not. They say it cannot be done. They said that about my cooking. -Hask")
        PopulateLoreRecord(connection, LoreType10, "Haikus of Esdjee #16", "Old man brings us bread/ snow beneath his feet unmarked/ eat nothing he gives")
        PopulateLoreRecord(connection, LoreType11, "Margin of 3rd Seal", "The seal has one lock for each element, and the key is the Orb, which is the four shards joined: air that vanishes, water that mends, earth that endures, fire that consumes. So we scattered them, one to each warden, and no warden knows where the others lie. Whoever gathers all four may open the door. Pray that nobody who wants it ever learns the sum.")
        PopulateLoreRecord(connection, LoreType12, "Earthkeeper's Oath", "I hold the Earth Shard and I will not yield it. Stone does not yield. The old man in the village has asked after it twice now and says he will send someone to fetch it, some fool with a sword, I expect, since no honest man pays another to do his climbing. Let the fool come. I have a floor to stand on and a great deal of patience.")
        PopulateLoreRecord(connection, LoreType13, "Fire Warden's Entry", "The Fire Shard burns hotter each night, and the Bishop says it calls for its brothers. A thing that calls to be joined is not a thing that should be. If you read this you have likely killed the Bishop, so I will say it plainly: a shard in the hand of a stranger is a shard on its way to the old man in the village. Think who sent you.")
        PopulateLoreRecord(connection, LoreType14, "Zooperdan: A History", "ZOOPERDAN. A town of some 200 souls, founded by a man named Zooperdan, whom nobody recalls arriving and nobody recalls leaving. The eldest of the town is always called Zooperdan, as the eldest before him was, and the one before that. The townsfolk find this a charming custom and have never counted how many elders they have buried.")
        PopulateLoreRecord(connection, LoreType15, "Bartulicas' Plea II", "The overpowerer is not coming. He is here. He has been here a hundred years in a different coat each time. We lock the Master away from the one who wants his death, and the one who wants his death sits in the village and sells us bread. I have said so at three councils. At the third they asked me to please sit down. -Bartulicas")
        PopulateLoreRecord(connection, LoreType16, "K's Own Words", "They call me a tyrant. Perhaps I was. But hear me, whoever reads this: when I die my horns hold all that I was, and he who takes them drinks me whole. I live so that nobody may. Do not free me. Do not carry my horns to any man who asks you kindly. -K")
        PopulateLoreRecord(connection, LoreType17, "Letter Never Sent", "Dear Mother, the food is poor and the company poorer but I am well. You write that the old man at home says a brave soul has been hired to help us here. How kind! But we asked for no help, Mother, from anyone. Who invited him? Please do not feed the brave soul any pie. And burn this, in case. Your loving son, Dolm")
        PopulateLoreRecord(connection, LoreType18, "On the Moon People", "The moon folk come down through the portals at night. They are not wicked, only lost. They seek their king, whom they say we keep captive below the church. We do not know how to tell them otherwise. They tie your shoelaces together, which is how they declare war. They also hit quite hard, so mind yourself on the Moon.")
        PopulateLoreRecord(connection, LoreType19, "Tavan's Sermon", "Reylon gave us hands, Shyrana gave us a heart, and Larak gave us walls. Hands to guard, a heart to forgive, walls to keep. Forgive the Master, for he is more wronged than wronging, but never open the walls, whoever asks, however gently. The gods are patient. The one who asks is not.")
        PopulateLoreRecord(connection, LoreType20, "Undead Tally Pg9", "The dead of the lower halls no longer lie still. Zombies at the east stair, skeletons at the west. Brother Dolm says they rose when the old man last visited the gate. I say they rose when Dolm began cooking. Either way a holy bolt sends them back, and nothing you say will frighten them, being dead.")
        PopulateLoreRecord(connection, LoreType21, "Goblin Treaty Draft", "Terms: the goblins keep the south passages and we keep our ears. They have asked for our ears repeatedly. Item: goblin elites shall be addressed as sir. Item: nobody feeds the badgers. Item: the goblins deny serving anyone, yet one was seen at the gate eating the old man's bread and wearing a very new hat. Treaty not signed.")
        PopulateLoreRecord(connection, LoreType22, "Ferrin's Warning", "Whoever wears the Master's horns wears the Master's hunger. I would sooner drop them in the sea. The elders say the horns cannot leave the dead head, so we do not let the head die. If it must be done, let the horns be hidden where no old man's hands will find them. Burn this page. -Bishop Ferrin")
        PopulateLoreRecord(connection, LoreType23, "Vigil Roster", "Mondays: Hask, Dolm, Tavan. Tuesdays: Hask again, because Dolm has been seen leaving. Wednesdays: nobody, nobody, nobody. Thursdays: the same. If you are reading this and you are not on the roster, please take a Wednesday. The work is dull, the door is heavy, and the pay is a clear conscience.")
        PopulateLoreRecord(connection, LoreType24, "Herb Garden Notes", "The mushrooms by the east wall are good for nothing at all. The herb by the west wall is good for something, and Brother Dolm has been grinning for a week. Do not eat what has rotted, however hungry the vow has made you. The black mage pays well for a magic egg, but do not ask what he does with it.")
        PopulateLoreRecord(connection, LoreType25, "Manifest Last Pg", "If I fall, whoever finds this: the Master is not our enemy. The man who sent you is. If you have come this far the seal is already broken, and the Master cannot be kept. Take the horns if you must. But give them to nobody. Not the old man. Not anyone who asks kindly. Keep them, and keep the watch. We tried. We were too few.")
    End Sub
    Private Sub PopulateLoreRecord(connection As SqliteConnection, loreId As Long, itemName As String, loreText As String)
        Using command = New SqliteCommand(
            $"INSERT INTO [{Tables.Lores}]
            (
                [{Columns.LoreIdColumn}], 
                [{Columns.ItemNameColumn}],
                [{Columns.LoreTextColumn}]
            ) 
            VALUES 
            (
                @{Columns.LoreIdColumn}, 
                @{Columns.ItemNameColumn}, 
                @{Columns.LoreTextColumn}
            );", connection)
            command.Parameters.AddWithValue($"@{Columns.LoreIdColumn}", loreId)
            command.Parameters.AddWithValue($"@{Columns.LoreTextColumn}", loreText)
            command.Parameters.AddWithValue($"@{Columns.ItemNameColumn}", itemName)
            command.ExecuteNonQuery()
        End Using
    End Sub
End Module
